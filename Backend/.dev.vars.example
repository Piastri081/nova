# Copy this file to .dev.vars for local development. Never commit .dev.vars.
CODE_PEPPER=replace-with-a-long-random-string
DEV_RETURN_CODE=true

# Email (Resend). Verify your sending domain in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=Nova <login@your-domain.example>

# SMS (Twilio). TWILIO_FROM must be an E.164 number you own.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
